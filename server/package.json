{
  "name": "risk-register-server",
  "version": "1.0.0",
  "description": "Fastify API for the Risk Register application",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc --project tsconfig.json",
    "build:web": "vite build",
    "dev": "npm run build:web && tsx watch src/server.ts",
    "predocs:generate": "npm run build:web",
    "docs:generate": "tsx scripts/exportOpenApi.ts",
    "prestart": "npm run build",
    "start": "node dist/src/server.js",
    "pretest": "npm run build:web",
    "test": "tsx --test test/app.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.web.json"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "bootstrap": "^5.3.8",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
